# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app/docker-project ###
# Distinguish this checkout's Docker Compose resources from other librarian-mcp directories.
COMPOSE_PROJECT_NAME=librarian-mcp-dev
###< app/docker-project ###

###> app/docker-ports ###
# Override in .env.local if ports conflict with another project.
# HTTP_PORT=8080
# HTTPS_PORT=8443
###< app/docker-ports ###

###> app/docker-dns ###
# If Docker inherits an unusable resolver (e.g. 127.0.0.53), override DNS here.
# DOCKER_DNS_PRIMARY=1.1.1.1
# DOCKER_DNS_SECONDARY=8.8.8.8
###< app/docker-dns ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/data/app"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/data/app"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app/rate-limiter ###
# Max app submissions per client IP per day (sliding window)
APP_SUBMIT_RATE_LIMIT=2
###< app/rate-limiter ###

###> symfony/mcp-bundle ###
# Hostnames only (no scheme or port). Add the public deployment hostname in .env.prod.local.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,php,server,192.168.2.38
###< symfony/mcp-bundle ###

###> app/hatfield-sources ###
# Directory picker starts at this service-visible path. Not a security allowlist.
PROJECT_BROWSE_ROOT=/projects
# Host directory deliberately mounted read-only at /projects by Compose.
PROJECTS_HOST_PATH=.
# Logical Hatfield runtime context, not the container's /root home.
# Configure read-only settings/data mounts in ignored compose.sources.yaml.
HATFIELD_USER_HOME=
HATFIELD_APP_ROOT=
HATFIELD_PATH_MAPPINGS='{}'
###< app/hatfield-sources ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
# Messenger DeduplicateStamp requires a serializable store (sqlite: → PdoStore).
LOCK_DSN='sqlite:%kernel.project_dir%/data/indexing-locks.db'
###< symfony/lock ###

###> app/indexing-runtime ###
# Local OpenAI-compatible CodeRank / BGE endpoints on the Docker host.
CODERANK_URL=http://host.docker.internal:8059/v1
CODERANK_MODEL=CodeRankEmbed
# Measured local GGUF SHA-256; public artifact identity, not a credential.
CODERANK_ARTIFACT=02d538aa88acbe61da8aa5c4f9261d55aed8d55ee3054c0c43a9977d63d45a61
BGE_URL=http://host.docker.internal:8060/v1
BGE_MODEL=bge-reranker-base
# Private Compose service; no published host port.
CHROMA_HOST=http://chroma
CHROMA_PORT=8000
INDEX_STORAGE_DIR=data/indexes
INDEX_INTERVAL=60
###< app/indexing-runtime ###
