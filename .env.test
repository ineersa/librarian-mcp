# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Isolated browser-live SQLite prepared by the runtime child.
DATABASE_URL='sqlite:///%kernel.project_dir%/var/browser-live/application.db'

# Keep test filesystem state isolated from development data.
LIBRARY_DATA_DIR=var/browser-live/data
