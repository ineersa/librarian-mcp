# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Isolated browser-live PostgreSQL prepared by Castor.
# Native-network PHPUnit uses the checkout-private Compose service DNS.
POSTGRES_DB=librarian_browser
POSTGRES_USER=librarian
POSTGRES_PASSWORD=browser-synthetic-only
DATABASE_URL='postgresql://librarian:browser-synthetic-only@postgres:5432/librarian_browser?serverVersion=17&charset=utf8'

# Synthetic source context; app/worker mount only these read-only source fixtures.
PROJECT_BROWSE_ROOT=/project-sources
HATFIELD_USER_HOME=/synthetic-home
HATFIELD_APP_ROOT=/synthetic-app
HATFIELD_PATH_MAPPINGS='{"/synthetic-home":"/project-sources/context-home","/synthetic-app":"/project-sources/context-app"}'

# Isolated indexing runtime for browser journeys.
INDEX_STORAGE_DIR=var/browser-live/indexes
INDEX_INTERVAL=2
LOCK_DSN='postgresql://librarian:browser-synthetic-only@postgres:5432/librarian_browser?serverVersion=17&charset=utf8'
CODERANK_URL=http://host.docker.internal:8059/v1
CODERANK_MODEL=CodeRankEmbed
CODERANK_ARTIFACT=02d538aa88acbe61da8aa5c4f9261d55aed8d55ee3054c0c43a9977d63d45a61
BGE_URL=http://host.docker.internal:8060/v1
BGE_MODEL=bge-reranker-base
