{
    "name": "ineersa/librarian-mcp",
    "description": "Read-only Hatfield project source discovery and shared memory service",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.3",
        "easycorp/easyadmin-bundle": "^5.0",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*",
        "nyholm/psr7": "^1.8",
        "php": "^8.5",
        "phpdocumentor/reflection-docblock": "^5.6.7 || ^6.0",
        "phpstan/phpdoc-parser": "^2.3.2",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/asset": "~8.2.0-BETA1",
        "symfony/asset-mapper": "~8.2.0-BETA1",
        "symfony/cache": "~8.2.0-BETA1",
        "symfony/clock": "~8.2.0-BETA1",
        "symfony/config": "~8.2.0-BETA1",
        "symfony/console": "~8.2.0-BETA1",
        "symfony/dependency-injection": "~8.2.0-BETA1",
        "symfony/doctrine-bridge": "~8.2.0-BETA1",
        "symfony/doctrine-messenger": "~8.2.0-BETA1",
        "symfony/dotenv": "~8.2.0-BETA1",
        "symfony/error-handler": "~8.2.0-BETA1",
        "symfony/event-dispatcher": "~8.2.0-BETA1",
        "symfony/expression-language": "~8.2.0-BETA1",
        "symfony/filesystem": "~8.2.0-BETA1",
        "symfony/finder": "~8.2.0-BETA1",
        "symfony/flex": "^2.10",
        "symfony/form": "~8.2.0-BETA1",
        "symfony/framework-bundle": "~8.2.0-BETA1",
        "symfony/http-client": "~8.2.0-BETA1",
        "symfony/http-foundation": "~8.2.0-BETA1",
        "symfony/http-kernel": "~8.2.0-BETA1",
        "symfony/intl": "~8.2.0-BETA1",
        "symfony/mcp-bundle": "^0.15.0",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "~8.2.0-BETA1",
        "symfony/mime": "~8.2.0-BETA1",
        "symfony/monolog-bridge": "~8.2.0-BETA1",
        "symfony/monolog-bundle": "^3.0|^4.0.2",
        "symfony/notifier": "~8.2.0-BETA1",
        "symfony/options-resolver": "~8.2.0-BETA1",
        "symfony/password-hasher": "~8.2.0-BETA1",
        "symfony/process": "~8.2.0-BETA1",
        "symfony/property-access": "~8.2.0-BETA1",
        "symfony/property-info": "~8.2.0-BETA1",
        "symfony/psr-http-message-bridge": "~8.2.0-BETA1",
        "symfony/rate-limiter": "~8.2.0-BETA1",
        "symfony/routing": "~8.2.0-BETA1",
        "symfony/runtime": "~8.2.0-BETA1",
        "symfony/security-bundle": "~8.2.0-BETA1",
        "symfony/security-core": "~8.2.0-BETA1",
        "symfony/security-csrf": "~8.2.0-BETA1",
        "symfony/security-http": "~8.2.0-BETA1",
        "symfony/serializer": "~8.2.0-BETA1",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/stopwatch": "~8.2.0-BETA1",
        "symfony/string": "~8.2.0-BETA1",
        "symfony/translation": "~8.2.0-BETA1",
        "symfony/twig-bridge": "~8.2.0-BETA1",
        "symfony/twig-bundle": "~8.2.0-BETA1",
        "symfony/type-info": "~8.2.0-BETA1",
        "symfony/uid": "~8.2.0-BETA1",
        "symfony/ux-turbo": "^3.0",
        "symfony/validator": "~8.2.0-BETA1",
        "symfony/var-dumper": "~8.2.0-BETA1",
        "symfony/var-exporter": "~8.2.0-BETA1",
        "symfony/web-link": "~8.2.0-BETA1",
        "symfony/yaml": "~8.2.0-BETA1",
        "symfonycasts/tailwind-bundle": "^0.12.0",
        "twig/extra-bundle": "^2.12|^3.24",
        "twig/twig": "^2.12|^3.24"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/ai-mate-composer-plugin": false
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*"
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "hautelook/alice-bundle": "^2.17",
        "jolicode/castor": "^1.9",
        "phpstan/phpstan": "^2.1.51",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpstan/phpstan-strict-rules": "^2.0.10",
        "phpunit/phpunit": "^13.1.7",
        "playwright-php/playwright": "^1.6",
        "symfony/ai-mate": "^0.15.0",
        "symfony/ai-monolog-mate-extension": "^0.15.0",
        "symfony/ai-symfony-mate-extension": "^0.15.0",
        "symfony/debug-bundle": "~8.2.0-BETA1",
        "symfony/maker-bundle": "^1.67",
        "symfony/tui": "8.1.11",
        "symfony/web-profiler-bundle": "~8.2.0-BETA1"
    }
}
