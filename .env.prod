# Production defaults (loaded when APP_ENV=prod).
# These merge over `.env` during `composer dump-env prod` (Docker build) and when running with APP_ENV=prod.
# Server secrets: `.env.prod.local` on the **build** host (gitignored); see `.env.prod.local.dist`.

###> app/docker-project ###
COMPOSE_PROJECT_NAME=librarian-mcp-prod
###< app/docker-project ###

###> doctrine/doctrine-bundle ###
POSTGRES_DB=librarian
POSTGRES_USER=librarian
# Override POSTGRES_PASSWORD / DATABASE_URL / LOCK_DSN in `.env.prod.local`.
POSTGRES_PASSWORD=ChangeMe
DATABASE_URL="postgresql://librarian:ChangeMe@postgres:5432/librarian?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/indexing ###
# Shared by production php and messenger through the existing data-prod bind (flock execution locks).
INDEX_STORAGE_DIR=data-prod/indexes
# Messenger DeduplicateStamp uses the shared PostgreSQL DoctrineDbalStore table (lock_keys).
LOCK_DSN='postgresql://librarian:ChangeMe@postgres:5432/librarian?serverVersion=17&charset=utf8'
###< app/indexing ###

###> app/rate-limiter ###
APP_SUBMIT_RATE_LIMIT=2
###< app/rate-limiter ###

###> symfony/mercure-bundle ###
# Publishing from Messenger workers / CLI: reach the FrankenPHP container by Compose service name.
MERCURE_URL=http://php/.well-known/mercure
# Browser-facing hub URL for `castor prod:up` on localhost; override in `.env.prod.local` on a real host.
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure
# Allowed browser origins for Mercure subscriptions (space-separated values).
MERCURE_CORS_ORIGINS="http://localhost http://127.0.0.1 http://localhost:8093 http://127.0.0.1:8093 http://192.168.2.38 http://192.168.2.38:8093 http://server http://server:8093"
###< symfony/mercure-bundle ###
