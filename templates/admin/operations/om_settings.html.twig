{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}

{% block content_title %}Observational memory model{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-9 col-xl-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Current selection</h2>
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Model</dt>
                        <dd class="col-sm-8">{{ current.model }}</dd>
                        {% if hasSelectableReasoning %}
                            <dt class="col-sm-4">Reasoning</dt>
                            <dd class="col-sm-8">{{ current.reasoningLevel.label() }}</dd>
                        {% endif %}
                        <dt class="col-sm-4">Context budget</dt>
                        <dd class="col-sm-8">{{ current.contextWindow|number_format }} tokens</dd>
                    </dl>

                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.presetId) }}
                        <div data-om-model-target="reasoningRow">
                            {{ form_row(form.reasoningLevel) }}
                        </div>
                        <button class="btn btn-primary" type="submit">Save OM model</button>
                    {{ form_end(form) }}
                    <p class="text-muted small mt-3 mb-0">Applies to new jobs only. Queued and in-flight jobs keep their settings.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
