{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {% set project = entity.instance %}
    {{ turbo_stream_from(statusTopics.project, private: true) }}

    {% include 'admin/project/status/_source_panel.html.twig' with {
        project: project,
        indexStatus: indexStatus
    } only %}

    {% include 'admin/project/status/_index_panel.html.twig' with {
        project: project,
        indexStatus: indexStatus
    } only %}

    {{ parent() }}
{% endblock %}

{% block detail_fields %}
    <details>
        <summary class="mb-3">Additional details (snapshot at page load)</summary>
        {{ parent() }}
    </details>
{% endblock %}
