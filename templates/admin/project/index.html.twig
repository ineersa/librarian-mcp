{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
    {{ turbo_stream_from(statusTopics.list, private: true) }}
    <p class="text-muted small mb-3">
        Source discovery and incremental indexing run automatically. Click a project row for details or use Search memory to search its index.
    </p>
    {{ parent() }}
{% endblock %}

{% block entity_row_attributes %}
    data-project-id="{{ entity.primaryKeyValue }}"
    {% if entity.instance.health is defined and entity.instance.health is not null %}
        data-project-health="{{ entity.instance.health.value }}"
    {% endif %}
{% endblock %}
