{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
    {{ turbo_stream_from(statusTopics.list) }}
    <p class="text-muted small mb-3">
        Source discovery and indexing are separate. Indexing starts automatically after discovery and checks for changes periodically. Check for updates is optional.
    </p>
    {{ parent() }}
{% endblock %}

{% block entity_row_attributes %}
    data-project-id="{{ entity.primaryKeyValue }}"
    {% if entity.instance.health is defined and entity.instance.health is not null %}
        data-project-health="{{ entity.instance.health.value }}"
    {% endif %}
{% endblock %}
