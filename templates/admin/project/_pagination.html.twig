{% if page.page_count > 1 %}
    {% set route = app.request.attributes.get('_route') %}
    {% set params = app.request.attributes.get('_route_params')|merge({
        (observationsPageQuery): observationsPage,
        (reflectionsPageQuery): reflectionsPage
    })|merge({(query): page.page}) %}
    {% set previousParams = params|merge({(query): page.page - 1}) %}
    {% set nextParams = params|merge({(query): page.page + 1}) %}
    <nav class="d-flex gap-2 align-items-center mt-2" aria-label="{{ label }} pagination">
        {% if page.page > 1 %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(route, previousParams) }}">Previous</a>
        {% endif %}
        <span class="small text-muted">Page {{ page.page }} of {{ page.page_count }}</span>
        {% if page.page < page.page_count %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(route, nextParams) }}">Next</a>
        {% endif %}
    </nav>
{% endif %}
