{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block content_title %}Search memory: {{ project.name }}{% endblock %}

{% block main %}
    <div id="project-memory-search" class="mb-3" data-project-id="{{ project.id }}">
        <p class="text-muted mb-3">
            Search this project's indexed memories. New memories become searchable automatically after indexing.
        </p>

        {% if activeGeneration %}
            <p class="small mb-3">
                <strong>{{ activeGeneration.parentCount|number_format }} indexed memories</strong>
                {% if project.lastSuccessfulIndexAt %}
                    · Last successful update: {{ project.lastSuccessfulIndexAt|date('Y-m-d H:i:s T') }}
                {% endif %}
            </p>
            <details class="small text-muted mb-3">
                <summary>Technical index details</summary>
                Generation <code data-search-active-generation>{{ activeGeneration.id }}</code>
                · {{ activeGeneration.state.label() }}
                · source revision {{ activeGeneration.committedRevision ?? 'none' }}
                · {{ activeGeneration.chunkCount|number_format }} text chunks
            </details>
        {% else %}
            <div class="alert alert-warning" data-search-no-active>
                Search will be available when this project's first indexing run finishes.
                Check the project details for progress or errors.
            </div>
        {% endif %}

        {{ form_start(form, { attr: { class: 'mb-4', 'data-turbo': 'false' } }) }}
            {{ form_row(form.question) }}
            {{ form_row(form.limit) }}
            {{ form_row(form.search) }}
        {{ form_end(form) }}

        {% if searchError %}
            <div class="alert alert-danger" data-search-error>{{ searchError }}</div>
        {% endif %}

        {% if searched and searchResult %}
            {% if searchResult.truncated %}
                <div class="alert alert-info" data-search-truncated>
                    Search considers a limited set of matches. A more specific question can help narrow the results.
                </div>
            {% endif %}

            {% if searchResult.results is empty %}
                <p class="text-muted" data-search-empty>
                    No matching memories found. Try a specific name, issue number or phrase.
                </p>
            {% else %}
                <div class="list-group" data-search-results>
                    {% for hit in searchResult.results %}
                        <article class="list-group-item" data-search-hit data-source-id="{{ hit.source_id }}" data-kind="{{ hit.kind }}">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <strong>{{ hit.kind|capitalize }}</strong>
                                </div>
                                <span class="small text-muted">
                                    {{ hit.occurred_at|date('Y-m-d H:i:s T') }}
                                </span>
                            </div>
                            <div class="small text-muted mb-1">
                                Session {{ hit.session_id }}
                            </div>
                            <pre class="small mb-0 text-wrap">{{ hit.snippet }}</pre>
                            <details class="small text-muted mt-2">
                                <summary>Technical result details</summary>
                                Memory <code>{{ hit.source_id }}</code> · chunk {{ hit.chunk_position }}
                                · ranking score {{ hit.rerank_score|number_format(4) }} (not a confidence estimate)
                            </details>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}

        <p class="mt-4 mb-0">
            <a href="{{ detailUrl }}" class="btn btn-link px-0">Back to project detail</a>
        </p>
    </div>
{% endblock %}
