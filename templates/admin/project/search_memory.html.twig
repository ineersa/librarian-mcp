{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Search memory: {{ project.name }}{% endblock %}

{% block main %}
    <div id="project-memory-search" class="mb-3" data-project-id="{{ project.id }}">
        <p class="text-muted mb-3">
            Bounded hybrid retrieval over the committed active index. Search never ingests or rebuilds sources.
            Rerank scores are uncalibrated ranking aids, not confidence.
        </p>

        {% if activeGeneration %}
            <p class="small mb-3">
                Active generation
                <code data-search-active-generation>{{ activeGeneration.id }}</code>
                · state {{ activeGeneration.state.label() }}
                · committed revision {{ activeGeneration.committedRevision ?? 'none' }}
                · parents {{ activeGeneration.parentCount }}
                · chunks {{ activeGeneration.chunkCount }}
            </p>
        {% else %}
            <div class="alert alert-warning" data-search-no-active>
                No active committed index is available for this project yet.
            </div>
        {% endif %}

        {{ form_start(form, { attr: { class: 'mb-4', 'data-turbo': 'false' } }) }}
            {{ form_row(form.question) }}
            <div class="row">
                <div class="col-md-4">{{ form_row(form.from) }}</div>
                <div class="col-md-4">{{ form_row(form.until) }}</div>
                <div class="col-md-4">{{ form_row(form.limit) }}</div>
            </div>
            {{ form_row(form.search) }}
        {{ form_end(form) }}

        {% if searchError %}
            <div class="alert alert-danger" data-search-error>{{ searchError }}</div>
        {% endif %}

        {% if searched and searchResult %}
            {% if searchResult.truncated %}
                <div class="alert alert-info" data-search-truncated>
                    Candidate budgets were truncated before ranking. Results may omit additional matches.
                </div>
            {% endif %}

            {% if searchResult.results is empty %}
                <p class="text-muted" data-search-empty>No ranked parents returned for this query.</p>
            {% else %}
                <div class="list-group" data-search-results>
                    {% for hit in searchResult.results %}
                        <article class="list-group-item" data-search-hit data-source-id="{{ hit.source_id }}" data-kind="{{ hit.kind }}">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <strong>{{ hit.kind }}</strong>
                                    <code class="ms-1">{{ hit.source_id }}</code>
                                </div>
                                <span class="small text-muted" title="Uncalibrated rerank score, not confidence">
                                    score {{ hit.rerank_score|number_format(4) }}
                                </span>
                            </div>
                            <div class="small text-muted mb-1">
                                run {{ hit.session_id }}
                                · date {{ hit.occurred_at|date('Y-m-d H:i:s', 'UTC') }} UTC
                                · chunk {{ hit.chunk_position }}
                            </div>
                            <pre class="small mb-0 text-wrap">{{ hit.snippet }}</pre>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}

        <p class="mt-4 mb-0">
            <a href="{{ detailUrl }}" class="btn btn-link px-0">Back to project detail</a>
        </p>
    </div>
{% endblock %}
