{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Projects dashboard{% endblock %}

{% block main %}
    {{ turbo_stream_from(messengerTopic, private: true) }}
    <section class="mb-4" aria-labelledby="messenger-heading">
        <h2 id="messenger-heading" class="h5">Background jobs</h2>
        {{ include('admin/messenger/_stats.html.twig') }}
        {{ include('admin/messenger/_delayed_retries.html.twig') }}
        <div class="card">
            <div class="card-body">
                <h3 class="h6 card-title">Failed messages</h3>
                {{ include('admin/messenger/_failed_list.html.twig') }}
                <details class="mt-3">
                    <summary>Bulk actions</summary>
                    {% set routes = constant('App\\Controller\\Admin\\DashboardController::MESSENGER_ROUTES') %}
                    <form method="post" action="{{ path(routes.retryAll) }}" data-turbo="true" class="mt-2">
                        {{ include('admin/messenger/_csrf.html.twig') }}
                        <label for="messenger-message-class" class="form-label">Message class (optional)</label>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <input class="form-control w-auto" id="messenger-message-class" name="class" placeholder="Exact class name">
                            <button class="btn btn-secondary" type="submit" data-turbo-confirm="Retry all failed messages matching the class filter? A blank filter includes every failed message.">Retry all</button>
                            <button class="btn btn-danger" type="submit" formaction="{{ path(routes.removeAll) }}" data-turbo-confirm="Permanently remove all failed messages matching the class filter? A blank filter includes every failed message.">Remove all</button>
                        </div>
                    </form>
                </details>
            </div>
        </div>
    </section>
    <div class="content-panel">
        <p class="text-muted mb-4">
            Register local Hatfield projects, discover OM/session sources, and inspect project health.
            Indexing arrives in plan04.
        </p>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Total</div>
                        <div class="h3 mb-0">{{ projectCounts.total }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Pending</div>
                        <div class="h3 mb-0">{{ projectCounts.pending }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Scanning</div>
                        <div class="h3 mb-0">{{ projectCounts.scanning }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Ready</div>
                        <div class="h3 mb-0">{{ projectCounts.ready }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Error</div>
                        <div class="h3 mb-0">{{ projectCounts.error }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <a class="btn btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('new') }}">
                Register Project
            </a>
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('index') }}">
                Projects
            </a>
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') }}">
                Users
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 card-title">Recent projects</h2>

                {% if recentProjects is empty %}
                    <p class="mb-0 text-muted">No projects registered yet.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Health</th>
                                    <th scope="col">Directory</th>
                                    <th scope="col">Observations</th>
                                    <th scope="col">Reflections</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for project in recentProjects %}
                                    <tr data-project-id="{{ project.id }}" data-project-health="{{ project.health.value }}">
                                        <td>
                                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('detail').setEntityId(project.id) }}">
                                                {{ project.name }}
                                            </a>
                                        </td>
                                        <td>
                                            <span data-project-health="{{ project.health.value }}">{{ project.health.label() }}</span>
                                        </td>
                                        <td><code>{{ project.rootPath }}</code></td>
                                        <td>{{ activeMemoryCounts[project.id].observations|default(0) }}</td>
                                        <td>{{ activeMemoryCounts[project.id].reflections|default(0) }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
