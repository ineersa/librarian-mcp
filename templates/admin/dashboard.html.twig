{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Projects dashboard{% endblock %}

{% block main %}
    <div class="content-panel">
        <p class="text-muted mb-4">
            Register local Hatfield projects, discover OM/session sources, and inspect project health.
            Indexing arrives in plan04.
        </p>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Total</div>
                        <div class="h3 mb-0">{{ projectCounts.total }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Pending</div>
                        <div class="h3 mb-0">{{ projectCounts.pending }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Scanning</div>
                        <div class="h3 mb-0">{{ projectCounts.scanning }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Ready</div>
                        <div class="h3 mb-0">{{ projectCounts.ready }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted small">Error</div>
                        <div class="h3 mb-0">{{ projectCounts.error }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <a class="btn btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('new') }}">
                Register Project
            </a>
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('index') }}">
                Projects
            </a>
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') }}">
                Users
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 card-title">Recent projects</h2>

                {% if recentProjects is empty %}
                    <p class="mb-0 text-muted">No projects registered yet.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Health</th>
                                    <th scope="col">Directory</th>
                                    <th scope="col">Observations</th>
                                    <th scope="col">Reflections</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for project in recentProjects %}
                                    <tr data-project-id="{{ project.id }}" data-project-health="{{ project.health.value }}">
                                        <td>
                                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('detail').setEntityId(project.id) }}">
                                                {{ project.name }}
                                            </a>
                                        </td>
                                        <td>
                                            <span data-project-health="{{ project.health.value }}">{{ project.health.label() }}</span>
                                        </td>
                                        <td><code>{{ project.rootPath }}</code></td>
                                        <td>{{ project.observationCount }}</td>
                                        <td>{{ project.reflectionCount }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
